# Secrets — never commit
.env
.env.local

# Generated artefacts (rebuilt by `make index` / produced at runtime)
vector_store/
escalations.jsonl
# eval/results/traces.jsonl is deliberately NOT here: unlike the vector store it cannot be
# rebuilt cheaply, and reproducing it costs ~300 LLM calls and yields different content
# (ADR-030). It is a measurement record, and SPEC 10.2's promise — recompute the metrics
# without re-running the agent — only holds for whoever has the file (ADR-073).
eval/results/smoke_traces.jsonl

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# Model caches (multilingual-e5-base is ~1.1 GB)
.cache/
hf_cache/

# OS
.DS_Store
