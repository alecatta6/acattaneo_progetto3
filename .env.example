# GreenThumb — copy to .env and fill in. Never commit .env.
#
# All project variables use the GREENTHUMB_ prefix (ADR-013). The provider key is
# the only exception: its name is imposed by the SDK.

# --- Provider (ADR-015) ---
OPENAI_API_KEY=sk-...

# --- Models ---
# Cheap model for development; the evaluation judge should be a stronger one so
# that the agent is not grading itself (ADR-010).
# NOTE: the identifiers below are PLACEHOLDERS. Check them against the provider's
# current catalogue before use — do not trust them as-is.
GREENTHUMB_LLM_MODEL=openai/gpt-4.1-mini
GREENTHUMB_EVAL_MODEL=openai/gpt-4.1

# --- Simulated business date (ADR-003) ---
GREENTHUMB_TODAY=2026-10-12

# --- Retrieval ---
GREENTHUMB_EMBEDDING_MODEL=intfloat/multilingual-e5-base
GREENTHUMB_RETRIEVAL_TOP_K=4
# Calibrated empirically in phase 2 — these are placeholders, not guesses to trust.
GREENTHUMB_RETRIEVAL_SCORE_LOW=0.0
GREENTHUMB_RETRIEVAL_SCORE_HIGH=0.0

# --- Short-term memory (ADR-004) ---
GREENTHUMB_SUMMARY_TRIGGER_TOKENS=2500
GREENTHUMB_SUMMARY_KEEP_MESSAGES=6

# --- Agent ---
GREENTHUMB_AGENT_MAX_ITERATIONS=8
