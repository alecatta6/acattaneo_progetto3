# GreenThumb — copy to .env and fill in. Never commit .env.
#
# All project variables use the GREENTHUMB_ prefix (ADR-013). The provider key is
# the only exception: its name is imposed by the SDK.

# --- Provider (ADR-015, amended by ADR-029) ---
# The project runs through OpenRouter, so model identifiers need the openrouter/ route
# prefix. LiteLLM reads the key from OPENAI_API_KEY for the openai-compatible path.
OPENAI_API_KEY=sk-or-v1-...

# --- Models ---
# Cheap model for development; the evaluation judge should be a stronger one so
# that the agent is not grading itself (ADR-010).
# NOTE: the identifiers below are PLACEHOLDERS. Check them against the provider's
# current catalogue before use — do not trust them as-is.
GREENTHUMB_LLM_MODEL=openrouter/openai/gpt-4.1-mini
GREENTHUMB_EVAL_MODEL=openrouter/openai/gpt-4.1

# --- Simulated business date (ADR-003) ---
GREENTHUMB_TODAY=2026-10-12

# --- Retrieval ---
GREENTHUMB_EMBEDDING_MODEL=intfloat/multilingual-e5-base
GREENTHUMB_RETRIEVAL_TOP_K=4
# Calibrated in phase 2 on the real knowledge base (docs/retrieval_calibration.md).
# Cosine similarity, not distance. Leave unset to use these same defaults from config.py.
GREENTHUMB_RETRIEVAL_SCORE_LOW=0.813
GREENTHUMB_RETRIEVAL_SCORE_HIGH=0.863

# --- Short-term memory (ADR-004) ---
# Compared against the token total the provider reports for the whole request, system
# prompt and tool schemas included, not against the conversation alone. The first call of
# a conversation already reports ~2583 tokens, so anything near 2500 would summarise before
# every single model call. Calibrated value: 6000 (ADR-056, re-calibrated in ADR-072).
GREENTHUMB_SUMMARY_TRIGGER_TOKENS=6000
GREENTHUMB_SUMMARY_KEEP_MESSAGES=6

# --- Agent ---
GREENTHUMB_AGENT_MAX_ITERATIONS=8
# Never leave this unset: LiteLLM otherwise asks for 65536 output tokens and OpenRouter
# refuses the call with a 402 (ADR-031).
GREENTHUMB_MAX_OUTPUT_TOKENS=1024
